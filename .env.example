# ============================================================================
# ROOT ENVIRONMENT FILE — used by docker-compose.yml to configure all services
# Copy this file to ".env" (same folder) and adjust values for your machine.
# Individual services also read backend/.env.example and frontend/.env.example
# when run OUTSIDE Docker (native dev mode).
# ============================================================================

# ---- General ----
PROJECT_NAME=ztsaacm-dashboard
ENVIRONMENT=development

# ---- PostgreSQL ----
POSTGRES_USER=ztsaacm
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ztsaacm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
# Generate a strong random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change_me_dev_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# ---- Session lifecycle (Module 3) ----
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_MINUTES=480
SESSION_SWEEP_INTERVAL_SECONDS=30
SESSION_WS_HEARTBEAT_SECONDS=20
# 2026-09-16: grace window for a page-refresh/tab-drop to reconnect with the
# same token and reattach to its existing session instead of opening a new one.
SESSION_RECONNECT_GRACE_SECONDS=5

# ---- Dynamic ACL (Module 4) ----
ACL_ENFORCEMENT_BACKEND=auto
ACL_PROTECTED_RESOURCE=protected-app
ACL_IPSET_V4=ztsaacm_allowed
ACL_IPSET_V6=ztsaacm_allowed_v6
ACL_ENTRY_TTL_SECONDS=900
L_PEP_WORKER_ENABLED=true
L_PEP_POLL_TIMEOUT_SECONDS=1

# ---- Trust Score Engine (Module 5) ----
# Full per-factor weight table is in backend/app/core/config.py (all env-
# overridable). Common knobs:
TRUST_SCORE_BASELINE=70
TRUST_RISK_LOW_MIN=80
TRUST_RISK_MEDIUM_MIN=50
TRUST_FAILED_LOGIN_THRESHOLD=3
TRUST_FAILED_LOGIN_WINDOW_MINUTES=15
TRUST_LOCAL_UTC_OFFSET_HOURS=0
# STATIC DEMO SAMPLES, not a live threat feed.
TRUST_APPROVED_VPN_CIDRS_RAW=10.8.0.0/24,10.9.0.0/24
TRUST_KNOWN_VPN_CIDRS_RAW=185.220.100.0/22,185.220.101.0/24,51.75.0.0/16,45.83.220.0/22

# ---- Adaptive MFA (Module 6) ----
MFA_ENABLED=true
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_OTP_LENGTH=6
# Account-level lockout, Redis-backed, separate from MFA_MAX_ATTEMPTS above;
# see backend/.env.example for the full explanation.
MFA_LOCKOUT_THRESHOLD=3
MFA_LOCKOUT_WINDOW_MINUTES=15
MFA_LOCKOUT_DURATION_MINUTES=15
# ---- Continuous Trust Evaluation (Module 7) ----
# Account-level RISK lockout (2026-09-14 hardening); see backend/.env.example
# for the full explanation. Only a direct HIGH-risk crossing counts.
RISK_LOCKOUT_TIER1_HOURS=1
RISK_LOCKOUT_TIER2_HOURS=4
RISK_LOCKOUT_TIER3_HOURS=7
RISK_LOCKOUT_WINDOW_HOURS=24
# Mid-session re-verification window (risk_retrigger) -- shorter than
# MFA_CHALLENGE_TTL_MINUTES above on purpose; see backend/.env.example.
MFA_RETRIGGER_TTL_MINUTES=3
# Real Passive Network Detection (Section 18 hardening, 2026-09-15) -- the
# automatic heartbeat detector; see backend/.env.example for the full
# explanation. HEARTBEAT_INTERVAL_SECONDS is also read by the frontend via
# VITE_HEARTBEAT_INTERVAL_SECONDS below -- keep the two in sync.
HEARTBEAT_INTERVAL_SECONDS=20
HEARTBEAT_STATE_TTL_SECONDS=3600
# abnormal_request_rate counting (redesigned 2026-09-15, same day as the
# initial implementation): every non-GET/HEAD/OPTIONS authenticated REST
# call anywhere in the app counts, not only heartbeat calls -- see
# backend/.env.example for the full explanation.
REQUEST_RATE_WINDOW_SECONDS=60
REQUEST_RATE_THRESHOLD=20
# Gmail SMTP -- the account MFA codes are sent FROM. Leave blank in dev/test:
# the code is logged server-side instead of emailed (see MFA_DEV_EXPOSE_CODE).
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# -- do NOT use the account's real login password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MFA_EMAIL_FROM_NAME=ZTSAACM Security
MFA_DEV_EXPOSE_CODE=false   # true (or ENVIRONMENT=development) exposes the code — demo only

# ---- Frontend (React/Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Must match HEARTBEAT_INTERVAL_SECONDS above -- the frontend's own polling
# cadence for the Section 18 passive-detection heartbeat (Module 7).
VITE_HEARTBEAT_INTERVAL_SECONDS=20
