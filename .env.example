# ============================================================================
# ROOT ENVIRONMENT FILE — used by docker-compose.yml to configure all services
# Copy this file to ".env" (same folder) and adjust values for your machine.
# Individual services also read backend/.env.example and frontend/.env.example
# when run OUTSIDE Docker (native dev mode).
# ============================================================================

# ---- General ----
PROJECT_NAME=ztsaacm-dashboard
ENVIRONMENT=development

# ---- PostgreSQL ----
POSTGRES_USER=ztsaacm
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ztsaacm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
# Generate a strong random value for real use, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change_me_dev_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# ---- Session lifecycle (Module 3) ----
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_MINUTES=480
SESSION_SWEEP_INTERVAL_SECONDS=30
SESSION_WS_HEARTBEAT_SECONDS=20

# ---- Dynamic ACL (Module 4) ----
ACL_ENFORCEMENT_BACKEND=auto
ACL_PROTECTED_RESOURCE=protected-app
ACL_IPSET_V4=ztsaacm_allowed
ACL_IPSET_V6=ztsaacm_allowed_v6
ACL_ENTRY_TTL_SECONDS=900
L_PEP_WORKER_ENABLED=true
L_PEP_POLL_TIMEOUT_SECONDS=1

# ---- Trust Score Engine (Module 5) ----
# Full per-factor weight table is in backend/app/core/config.py (all env-
# overridable). Common knobs:
TRUST_SCORE_BASELINE=70
TRUST_RISK_LOW_MIN=80
TRUST_RISK_MEDIUM_MIN=50
TRUST_FAILED_LOGIN_THRESHOLD=3
TRUST_FAILED_LOGIN_WINDOW_MINUTES=15
TRUST_LOCAL_UTC_OFFSET_HOURS=0
# STATIC DEMO SAMPLES, not a live threat feed.
TRUST_APPROVED_VPN_CIDRS_RAW=10.8.0.0/24,10.9.0.0/24
TRUST_KNOWN_VPN_CIDRS_RAW=185.220.100.0/22,185.220.101.0/24,51.75.0.0/16,45.83.220.0/22

# ---- Adaptive MFA (Module 6) ----
MFA_ENABLED=true
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_OTP_LENGTH=6
# Gmail SMTP -- the account MFA codes are sent FROM. Leave blank in dev/test:
# the code is logged server-side instead of emailed (see MFA_DEV_EXPOSE_CODE).
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# -- do NOT use the account's real login password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MFA_EMAIL_FROM_NAME=ZTSAACM Security
MFA_DEV_EXPOSE_CODE=false   # true (or ENVIRONMENT=development) exposes the code — demo only

# ---- Frontend (React/Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
