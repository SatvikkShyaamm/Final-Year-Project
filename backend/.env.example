# Used when running the backend NATIVELY (uvicorn on your host), not via
# Docker Compose. Copy to backend/.env. When running via Docker Compose,
# the root-level .env is what matters instead (postgres/redis hostnames
# there are the Compose service names, not "localhost").

PROJECT_NAME=ZTSAACM Security Dashboard
ENVIRONMENT=development

POSTGRES_USER=ztsaacm
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ztsaacm_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

BACKEND_PORT=8000
JWT_SECRET_KEY=change_me_dev_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
