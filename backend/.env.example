# Used when running the backend NATIVELY (uvicorn on your host), not via
# Docker Compose. Copy to backend/.env. When running via Docker Compose,
# the root-level .env is what matters instead (postgres/redis hostnames
# there are the Compose service names, not "localhost").

PROJECT_NAME=ZTSAACM Security Dashboard
ENVIRONMENT=development

POSTGRES_USER=ztsaacm
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=ztsaacm_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

BACKEND_PORT=8000
JWT_SECRET_KEY=change_me_dev_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# ---- Session lifecycle (Module 3) ----
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_MINUTES=480
SESSION_SWEEP_INTERVAL_SECONDS=30
SESSION_WS_HEARTBEAT_SECONDS=20

# ---- Dynamic ACL (Module 4) ----
# auto = real ipset if available, else simulated (records the allow-list in
# Redis). Set to 'ipset' on a Linux enforcement host with NET_ADMIN.
ACL_ENFORCEMENT_BACKEND=auto
ACL_PROTECTED_RESOURCE=protected-app
ACL_IPSET_V4=ztsaacm_allowed
ACL_IPSET_V6=ztsaacm_allowed_v6
ACL_ENTRY_TTL_SECONDS=900
# Run the L-PEP task consumer in this process. Set false when running the
# standalone infra/l-pep worker (python -m app.lpep) instead.
L_PEP_WORKER_ENABLED=true
L_PEP_POLL_TIMEOUT_SECONDS=1

# ---- Trust Score Engine (Module 5) ----
# The full per-factor weight table lives in app/core/config.py (all env-
# overridable, prefix TRUST_WEIGHT_*). The knobs a demo operator usually touches:
TRUST_SCORE_BASELINE=70
TRUST_RISK_LOW_MIN=80
TRUST_RISK_MEDIUM_MIN=50
TRUST_FAILED_LOGIN_THRESHOLD=3
TRUST_FAILED_LOGIN_WINDOW_MINUTES=15
TRUST_LOCAL_UTC_OFFSET_HOURS=0
# STATIC DEMO SAMPLES — not a live threat feed. Module 9's "Simulate Approved/
# Unknown VPN" buttons draw a source IP from these.
TRUST_APPROVED_VPN_CIDRS_RAW=10.8.0.0/24,10.9.0.0/24
TRUST_KNOWN_VPN_CIDRS_RAW=185.220.100.0/22,185.220.101.0/24,51.75.0.0/16,45.83.220.0/22
